\documentclass[paper=a4, fontsize=11pt, parskip=half,
  foldmarks=$if(recipient)$true$else$false$endif$,
  fromalign=right, fromlogo=$if(logo)$true$else$false$endif$,
  backaddress=$if(recipient)$true$else$false$endif$, pagenumber=botcenter]{scrlttr2}
\usepackage{xcolor}
$if(accent_color)$
\definecolor{accent}{HTML}{$accent_color$}
$else$
\definecolor{accent}{HTML}{444444}
$endif$
\input{shared/neutral.tex}
% scrlttr2 has no sectioning commands, but the Pandoc writer emits them for
% Markdown headings. In a letter a heading is a bold line of its own.
\newcommand{\neutralheading}[2]{\par\medskip\noindent{#1 #2}\par\nopagebreak\smallskip}
\ifdef{\section}{}{\NewDocumentCommand{\section}{s m}{\neutralheading{\large\bfseries}{#2}}}
\ifdef{\subsection}{}{\NewDocumentCommand{\subsection}{s m}{\neutralheading{\normalsize\bfseries}{#2}}}
\ifdef{\subsubsection}{}{\NewDocumentCommand{\subsubsection}{s m}{\neutralheading{\normalsize\bfseries\itshape}{#2}}}
\ifdef{\paragraph}{}{\NewDocumentCommand{\paragraph}{s m}{\neutralheading{\normalsize\bfseries}{#2}}}
\ifdef{\subparagraph}{}{\NewDocumentCommand{\subparagraph}{s m}{\neutralheading{\normalsize\itshape}{#2}}}
% scrlttr2 has no figure float, but the Pandoc writer emits a figure
% environment with a caption for an image alone in its paragraph. In a letter
% a figure is not a float: it stays where the author put it, on one page, with
% its caption set by the caption package as in the report.
\makeatletter
\ifdef{\c@figure}{}{\newcounter{figure}\renewcommand{\thefigure}{\arabic{figure}}}
\providecommand{\figurename}{Figure}
\providecommand{\fnum@figure}{\figurename~\thefigure}
\providecommand{\ext@figure}{lof}
\providecommand{\theHfigure}{\thefigure}
\newenvironment{figure}[1][]{%
  \par\addvspace{\baselineskip}\noindent
  \begin{minipage}{\linewidth}\centering\def\@captype{figure}}%
  {\end{minipage}\par\addvspace{\baselineskip}}
\makeatother
$if(highlighting-macros)$
\usepackage{fancyvrb}
$highlighting-macros$
$endif$

\newcommand{\documenttitle}{$title$}
\newcommand{\documentauthor}{$author$}
$if(title)$
\hypersetup{pdftitle=\documenttitle}
$endif$
$if(author)$
\hypersetup{pdfauthor=\documentauthor}
$endif$
$if(language)$
\hypersetup{pdflang=$language$}
$endif$

\setkomavar{fromname}{$name$}
$if(logo)$
\setkomavar{fromlogo}{\includegraphics[height=18mm]{$logo$}}
$endif$
$if(sender)$
\setkomavar{fromaddress}{$for(sender)$$sender$$sep$\\ $endfor$}
$endif$
$if(author)$
\setkomavar{signature}{$author$}
$endif$
$if(reference)$
\setkomavar{yourref}{$reference$}
$endif$
\setkomavar{date}{$date$}
\setkomavar{subject}{$subject$}
\setkomavar{firstfoot}{\parbox{\textwidth}{\centering\color{accent}\rule{\textwidth}{0.4pt}\\[1mm]\footnotesize\sffamily $name$}}

\begin{document}
\begin{letter}{$if(recipient)$$for(recipient)$$recipient$$sep$\\ $endfor$$else$\mbox{}$endif$}
\opening{$if(opening)$$opening$$endif$}

$body$

\closing{$if(closing)$$closing$$endif$}
$if(enclosures)$
\encl{$for(enclosures)$$enclosures$$sep$\\ $endfor$}
$endif$
$if(cc)$
\cc{$for(cc)$$cc$$sep$\\ $endfor$}
$endif$
\end{letter}
\end{document}
