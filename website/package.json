{
  "name": "outprint-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Outprint (Docusaurus).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand": "node scripts/sync-brand.mjs",
    "versions": "node scripts/docs-versions.mjs",
    "prestart": "npm run brand && npm run versions",
    "start": "docusaurus start",
    "prebuild": "npm run brand && npm run versions",
    "build": "docusaurus build",
    "serve": "docusaurus serve --no-open",
    "clear": "docusaurus clear",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/roboto": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
