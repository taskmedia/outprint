# Image pins of the development and E2E stack (deploy/dev/compose.yaml).
# One place, explicit tags, never "latest". Passed with --env-file by the
# Makefile. A variable of the same name in the shell wins over this file,
# which is how the weekly E2E run tries the newest Outline release.
#
# Bump one line, run `make dev-down-volumes dev e2e`, commit. The comments are
# annotations for Renovate's regex manager; Dependabot does not read env files.

# renovate: datasource=docker depName=outlinewiki/outline
OUTLINE_IMAGE=outlinewiki/outline:1.12.0
# renovate: datasource=docker depName=ghcr.io/dexidp/dex
DEX_IMAGE=ghcr.io/dexidp/dex:v2.46.1
# renovate: datasource=docker depName=postgres
POSTGRES_IMAGE=postgres:17.11-alpine
# renovate: datasource=docker depName=redis
REDIS_IMAGE=redis:7.4.12-alpine
